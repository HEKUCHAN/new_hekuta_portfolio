---
import type { ContentBlock, InfoPage } from "../data/pages";
import SiteFooter from "./common/SiteFooter.astro";

interface Props {
  page: InfoPage;
}

const { page } = Astro.props;
const sections: { lang: "ja" | "en"; label: string; blocks: ContentBlock[] }[] = [
  { lang: "ja", label: "日本語", blocks: page.ja },
  { lang: "en", label: "English", blocks: page.en },
];
const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
  <div class="mb-6">
    <a
      href="/"
      class="text-sm text-gray-500 hover:text-black hover:underline transition-colors"
    >
      &larr; Heitor Hirose
    </a>
  </div>
  <header class="mb-12">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900">{page.heading}</h1>
    <p class="text-sm text-gray-500 mt-2">Last updated: {page.lastmod}</p>
  </header>

  <main>
    {
      sections.map((section) => (
        <section lang={section.lang} class="mb-16">
          <h2 class="text-2xl font-bold border-b-2 border-gray-300 pb-2 mb-6">
            {section.label}
          </h2>
          <div class="space-y-8">
            {section.blocks.map((block) => (
              <div>
                <h3 class="font-bold text-gray-800 mb-2">{block.heading}</h3>
                <div class="text-base text-gray-700 leading-relaxed space-y-3">
                  {block.paragraphs?.map((p) => <p>{p}</p>)}
                </div>
                {block.items && (
                  <ul class="mt-3 list-disc list-inside text-gray-700 space-y-1.5">
                    {block.items.map((item) => (
                      <li>
                        {item.url ? (
                          <a
                            href={item.url}
                            class="text-blue-600 hover:text-blue-800 hover:underline transition-colors"
                            {...(isExternal(item.url)
                              ? { target: "_blank", rel: "noopener noreferrer" }
                              : {})}
                          >
                            {item.text}
                          </a>
                        ) : (
                          item.text
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </main>

  <SiteFooter lang="ja" />
</div>
