---
import { Image } from "astro:assets";
import { BsTwitterX } from "react-icons/bs";
import { FaGithub } from "react-icons/fa";
import { SiInstagram, SiZenn } from "react-icons/si";
import LastArticles from "./articles/LastArticles.astro";
import CareersEn from "./careers/CareersEn.astro";
import Works from "./profile/Works.astro";
import SiteFooter from "./common/SiteFooter.astro";
import { profileEn as profile } from "../data/profile";

import TUTBusImage from "../../public/tut-bus.png";
import heitorHiroseImage from "../assets/heitor_hirose.jpg";

const myName = "Heitor Hirose";
const myRole = "Student Engineer";
---

<div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
  <div class="flex justify-end mb-6">
    <div class="inline-flex items-center text-sm text-gray-500">
      <span class="mr-2">Language:</span>
      <a
        href="/"
        class="text-gray-500 hover:text-black hover:underline transition-colors"
      >
        日本語
      </a>
      <span class="mx-2 text-gray-400">/</span>
      <span class="font-semibold text-gray-900">English</span>
    </div>
  </div>
  <header class="mb-16 flex items-center space-x-6">
    <Image
      src={heitorHiroseImage}
      alt="Profile icon"
      class="w-24 h-24 md:w-32 md:h-32 rounded-full border-2 border-gray-300"
      priority
    />
    <div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
        {myName}
      </h1>
      <p class="text-lg text-gray-600 mt-1">{myRole}</p>
    </div>
  </header>

  <main>
    <section id="about" class="mb-16">
      <h2 class="text-2xl font-bold border-b-2 border-gray-300 pb-2 mb-6">
        About
      </h2>
      <div
        id="about-content"
        class="text-base text-gray-700 leading-relaxed space-y-4"
      >
        <p>
          {
            profile.about.map((paragraph, i) => (
              <Fragment>
                {i > 0 && (
                  <Fragment>
                    <br />
                    <br />
                  </Fragment>
                )}
                {paragraph}
              </Fragment>
            ))
          }
        </p>
      </div>
    </section>
  </main>

  <section id="career" class="mb-16">
    <h2 class="text-2xl font-bold border-b-2 border-gray-300 pb-2 mb-6">
      Career
    </h2>
    <CareersEn />
  </section>

  <section id="interests" class="mb-16">
    <h2 class="text-2xl font-bold border-b-2 border-gray-300 pb-2 mb-6">
      Interests
    </h2>
    <ul class="list-disc list-inside text-gray-700 space-y-2">
      {profile.interests.map((interest) => <li>{interest}</li>)}
    </ul>
  </section>

  <section id="works" class="mb-16">
    <h2 class="text-2xl font-bold border-b-2 border-gray-300 pb-2 mb-8">
      Works
    </h2>

    <div class="space-y-12">
      {
        profile.works.map((work) => (
          <Works {...work} projectImage={TUTBusImage} />
        ))
      }

      <p>{profile.worksFooter}</p>
    </div>
  </section>

  <section id="latest-articles" class="mb-16">
    <h2 class="text-2xl font-bold border-b-2 border-gray-300 pb-2 mb-8">
      Latest Articles
    </h2>
    <LastArticles />
    <div class="text-right mt-6">
      <a
        href="https://zenn.dev/hekuchandao"
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-600 hover:text-black hover:underline font-medium transition-colors"
      >
        View more articles on Zenn &rarr;
      </a>
    </div>
  </section>

  <section id="social">
    <h2 class="text-2xl font-bold border-b-2 border-gray-300 pb-2 mb-6">
      Social
    </h2>
    <div
      class="flex flex-col space-y-1 md:flex-row md:justify-between md:items-center"
    >
      <div>
        <p class="text-gray-700">
          Feel free to reach out through any of the social accounts below.
        </p>
        <div class="flex space-x-5 mt-6">
          <a
            href="https://x.com/Heitor_Hirose"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-gray-800 transition-colors"
            aria-label="X"><div class="text-2xl"><BsTwitterX /></div></a
          >
          <a
            href="https://www.instagram.com/hirose_heitor/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-gray-800 transition-colors"
            aria-label="Instagram"
            ><div class="text-2xl"><SiInstagram /></div></a
          >
          <a
            href="https://github.com/HEKUCHAN"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-gray-800 transition-colors"
            aria-label="GitHub"><div class="text-2xl"><FaGithub /></div></a
          >
          <a
            href="https://zenn.dev/hekuchandao"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-500 hover:text-gray-800 transition-colors"
            aria-label="Zenn"><div class="text-2xl"><SiZenn /></div></a
          >
        </div>
      </div>
      <a
        href="https://lcn.ad.jp/"
        target="_blank"
        rel="noopener noreferrer"
        class="pt-8 md:pt-0"
      >
        <div class="flex flex-col items-center justify-start">
          <Image
            src="/linuxclub.png"
            alt="LinuxClub"
            width={60}
            height={60}
            class="opacity-60 hover:opacity-100 transition-opacity"
          />
          <div
            class="flex items-center mt-3 text-sm text-muted-foreground text-gray-600"
          >
            <span>Member of LinuxClub</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <SiteFooter lang="en" />
</div>
